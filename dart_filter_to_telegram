        # 실행이 죽으면 텔레그램이 그냥 조용해져서, 사용자는 "오늘 신호가 없는 것"과
        # "봇이 멈춘 것"을 구분할 수 없다. 최소한 실패 사실만은 알린다.
        alert = (
            f"🚨 DART 봇 실행 실패 (KST {target_date})\n"
            f"{type(exc).__name__}: {exc}"
        )
        print(alert)
        if not args.dry_run and TG_TOKEN and TG_CHAT_ID:
            try:
                tg_send(alert, TG_CHAT_ID)
            except Exception as send_exc:
                print(f"[warn] 실패 알림 전송도 실패: {send_exc}")
        raise
