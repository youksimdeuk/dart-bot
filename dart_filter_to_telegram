def tg_get_chat_id_auto() -> Optional[str]:
    """
    봇에게 /start를 보낸 이후 getUpdates에서 가장 최근 사용자 chat_id를 찾음.
    운영 안정성을 위해서는 TELEGRAM_CHAT_ID를 .env에 고정 추천.
    """
    try:
        r = requests.get(f"{TG_BASE}/getUpdates", timeout=15)
        data = r.json()
        if not data.get("ok"):
            return None
        updates = data.get("result", [])
        for upd in reversed(updates):
            msg = upd.get("message") or upd.get("edited_message")
            if msg and msg.get("chat") and msg["chat"].get("id"):
                return str(msg["chat"]["id"])
    except (requests.RequestException, ValueError, TypeError, KeyError):
        return None
    return None


def tg_send(text: str, chat_id: str) -> None:
    MAX = 3500
    chunks = [text[i:i + MAX] for i in range(0, len(text), MAX)] or [""]
    for chunk in chunks:
        payload = {"chat_id": chat_id, "text": chunk, "disable_web_page_preview": True}
        resp = requests.post(f"{TG_BASE}/sendMessage", data=payload, timeout=20)
        if resp.status_code != 200:
            raise RuntimeError(f"텔레그램 전송 실패(status={resp.status_code}): {resp.text[:200]}")
        try:
            data = resp.json()
        except ValueError as exc:
            raise RuntimeError(f"텔레그램 응답 파싱 실패: {resp.text[:200]}") from exc
        if not data.get("ok"):
            raise RuntimeError(f"텔레그램 API 오류: {data}")


# ====== OpenDART 호출 ======
DART_RETRIES = 3
DART_BACKOFF_SEC = 2
DART_STATUS_NO_DATA = "013"  # 조회 데이터 없음 — 오류가 아님
# 일시적 사유(요청 한도 초과·시스템 점검)라 재시도하면 풀린다
DART_RETRYABLE_STATUS = {"020", "021", "800", "901"}

# 조회 실패로 판정을 내리지 못하고 버린 공시 수. 조용히 유실되면 사용자가
# 신호가 없는 건지 못 받은 건지 구분할 수 없으므로 요약에 함께 알린다.
_dropped_count = 0


def note_dropped(context: str) -> None:
    global _dropped_count
    _dropped_count += 1
    print(f"[warn] 조회 실패로 공시 판정 불가: {context}")


def dart_get(endpoint: str, params: Dict, context: str) -> Optional[Dict]:
    """DART API 호출. 실패는 None으로 알리고 절대 조용히 넘어가지 않는다."""
    for attempt in range(1, DART_RETRIES + 1):
        try:
            r = requests.get(f"{DART_BASE}/{endpoint}", params=params, timeout=20)
            r.raise_for_status()
            data = r.json()
        except (requests.RequestException, ValueError) as exc:
            if attempt == DART_RETRIES:
                print(f"[warn] DART 호출 실패 {endpoint} ({context}): {exc}")
                return None
            time.sleep(DART_BACKOFF_SEC * attempt)
            continue

        status = str(data.get("status", ""))
        if status in ("000", DART_STATUS_NO_DATA):
            return data
        if status in DART_RETRYABLE_STATUS and attempt < DART_RETRIES:
            time.sleep(DART_BACKOFF_SEC * attempt)
            continue
        print(
            f"[warn] DART status={status} {endpoint} ({context}): "
            f"{data.get('message', '')}"
        )
        return None
    return None


def dart_list(bgn_de: str, end_de: str) -> List[Dict]:
    """당일 공시 목록(list.json). 페이지네이션 처리."""
    params = {
        "crtfc_key": DART_API_KEY,
        "bgn_de": bgn_de,
        "end_de": end_de,
        "page_no": 1,
        "page_count": 100,
    }
    out: List[Dict] = []
    while True:
        page = int(params["page_no"])
        data = dart_get("list.json", params, f"공시목록 p{page}")
        if data is None:
            # 목록이 중간에 잘리면 그날 공시 상당수가 통째로 사라진다. 조용히 넘기지 않는다.
            raise RuntimeError(
                f"공시 목록 조회 실패(page {page}). 목록이 불완전하므로 중단합니다."
            )
        if str(data.get("status")) == DART_STATUS_NO_DATA:
            break
        out.extend(data.get("list", []))
        total_page = int(data.get("total_page", 1))
        if page >= total_page:
            break
        params["page_no"] = page + 1
    return out


# 두 API 모두 corp_code 단위로 해당 법인의 전체 목록을 돌려준다. 한 법인이
# 하루에 여러 건을 공시하면 같은 목록을 반복해서 받게 되므로(2026-08-14 기준
# 103건 중 51건이 중복) 법인 단위로 한 번만 받아 재사용한다.
_corp_items_cache: Dict[Tuple[str, str], List[Dict]] = {}


def _dart_corp_items(endpoint: str, corp_code: str, context: str) -> Optional[List[Dict]]:
    key = (endpoint, corp_code)
    if key in _corp_items_cache:
        return _corp_items_cache[key]

    params = {"crtfc_key": DART_API_KEY, "corp_code": corp_code}
    data = dart_get(endpoint, params, context)
    if data is None:
        return None  # 실패는 캐시하지 않는다 — 다음 공시에서 다시 시도한다
    items = data.get("list", []) or []
    _corp_items_cache[key] = items
    return items


def _pick_by_rcept(items: List[Dict], rcept_no: str) -> Dict:
    for it in items:
        if str(it.get("rcept_no", "")) == str(rcept_no):
            return it
    return {}


def dart_majorstock_item(corp_code: str, rcept_no: str) -> Dict:
    """majorstock.json에서 rcept_no에 해당하는 1개 항목(dict) 반환(없으면 빈 dict)."""
    items = _dart_corp_items("majorstock.json", corp_code, f"대량보유 {rcept_no}")
    if items is None:
        note_dropped(f"대량보유 {rcept_no}")
        return {}
    return _pick_by_rcept(items, rcept_no)


def dart_elestock_item(corp_code: str, rcept_no: str) -> Dict:
    """elestock.json에서 rcept_no에 해당하는 1개 항목(dict) 반환(없으면 빈 dict)."""
    items = _dart_corp_items("elestock.json", corp_code, f"임원/주요주주 {rcept_no}")
    if items is None:
        note_dropped(f"임원/주요주주 {rcept_no}")
