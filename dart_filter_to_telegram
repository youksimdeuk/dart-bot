    return _pick_by_rcept(items, rcept_no)


def dart_elestock_actor(item: Dict) -> str:
    actor = str(item.get("repror", "")).strip()
    return actor if actor else ""


def dart_elestock_changes(
    item: Dict,
) -> Tuple[Optional[int], Optional[int], Optional[int], Optional[float], Optional[float], Optional[float]]:
    after_sh = num(item.get("sp_stock_lmp_cnt"))
    delta_sh = num(item.get("sp_stock_lmp_irds_cnt"))
    prev_sh = None
    if after_sh is not None and delta_sh is not None:
        prev_sh = after_sh - delta_sh

    after_r = fnum(item.get("sp_stock_lmp_rate"))
    delta_pp = fnum(item.get("sp_stock_lmp_irds_rate"))
    prev_r = None
    if after_r is not None and delta_pp is not None:
        prev_r = after_r - delta_pp

    return (delta_sh, prev_sh, after_sh, delta_pp, prev_r, after_r)


def dart_elestock_reason(item: Dict) -> str:
    parts: List[str] = []
    ofcps = str(item.get("isu_exctv_ofcps", "")).strip()
    if ofcps:
        parts.append(f"직위: {ofcps}")
    exctv = str(item.get("isu_exctv_rgist_at", "")).strip()
    if exctv:
        parts.append(f"임원등록: {exctv}")
    main_shr = str(item.get("isu_main_shrholdr", "")).strip()
    if main_shr:
        parts.append(f"주요주주: {main_shr}")
    return " | ".join(parts)


def dart_majorstock_actor(corp_code: str, rcept_no: str, item: Optional[Dict] = None) -> str:
    """
    대량보유에서 '늘어난 주체'를 DM에 보여주기 위해:
    - 우선순위: 보고의무자/보고자(Reporting person/entity) 성격 필드
    - 필드명이 케이스별로 달라 후보 키를 폭넓게 탐색
    """
    it = item if item is not None else dart_majorstock_item(corp_code, rcept_no)
    if not it:
        return ""

    # 1) 후보 키 우선 탐색
    key_candidates = [
        "rpt_psn", "rpt_nm", "rpt_name", "reporter", "reporter_nm", "reporter_name",
        "repr_nm", "repr_name", "repror", "nm", "name"
    ]

    def clean(s: str) -> str:
        return re.sub(r"\s+", " ", s).strip()

    # 명시적 키 우선
    for k in key_candidates:
        if k in it and isinstance(it.get(k), str) and clean(it.get(k)) not in ("", "-", "N/A"):
            return clean(it.get(k))

    # 2) 키 이름 휴리스틱(보고/의무/자/인 이름 계열)
    for k, v in it.items():
        if not isinstance(v, str):
            continue
        lk = str(k).lower()
        if any(t in lk for t in ["rpt", "report", "oblig", "duty", "psn", "person", "nm", "name"]) and "rcept" not in lk:
            vv = clean(v)
            if vv and vv not in ("-", "N/A"):
                return vv

    return ""


def dart_majorstock_reason(corp_code: str, rcept_no: str, item: Optional[Dict] = None) -> str:
    it = item if item is not None else dart_majorstock_item(corp_code, rcept_no)
    if not it:
        return ""
    parts: List[str] = []
    for k, v in it.items():
        if isinstance(v, str) and v.strip():
            if any(x in str(k).lower() for x in ["resn", "reason", "rm", "note", "change", "report"]):
                parts.append(v.strip())
    if not parts:
        for v in it.values():
            if isinstance(v, str) and v.strip():
                parts.append(v.strip())
    return " | ".join(parts)


def dart_majorstock_changes(
    corp_code: str, rcept_no: str, item: Optional[Dict] = None
) -> Tuple[Optional[int], Optional[int], Optional[int], Optional[float], Optional[float], Optional[float]]:
    """
    대량보유 상세에서
    - 주식수: (delta_shares, prev_shares, after_shares)
    - 보유비율(%): (delta_pp, prev_ratio, after_ratio)
    """
    it = item if item is not None else dart_majorstock_item(corp_code, rcept_no)
    if not it:
        return (None, None, None, None, None, None)

    # OpenDART majorstock 실제 주요 키:
    # - stkqy: 보고 후 보유주식수
    # - stkqy_irds: 주식수 증감
    # - stkrt: 보고 후 보유비율(%)
    # - stkrt_irds: 보유비율 증감(p.p.)
    delta_keys = [
        "stkqy_irds",
        "chg_stock_qty", "chg_stk_qty", "change_stock_qty", "stock_qty_chg", "delta_stock", "delta_qty",
    ]
    prev_keys = ["bfhold_stock_qty", "before_hold_stock_qty", "prev_hold_stock_qty", "hold_stock_qty_bf", "bf_stock_qty"]
    after_keys = [
        "stkqy",
        "afhold_stock_qty", "after_hold_stock_qty", "hold_stock_qty_af", "af_stock_qty", "hold_stock_qty",
        "ctr_stkqy",
    ]

    prev_r_keys = ["bfhold_stock_rt", "bfhold_stock_rate", "before_hold_ratio", "before_hold_rate", "hold_stock_rt_bf", "bf_ratio", "bf_rate"]
    after_r_keys = [
        "stkrt",
        "afhold_stock_rt", "afhold_stock_rate", "after_hold_ratio", "after_hold_rate", "hold_stock_rt_af", "af_ratio", "af_rate", "hold_stock_rt", "hold_stock_rate",
        "ctr_stkrt",
    ]
    delta_r_keys = [
        "stkrt_irds",
        "chg_hold_stock_rt", "chg_hold_stock_rate", "chg_ratio", "chg_rate", "delta_ratio", "delta_rate",
    ]

    def pick_int(keys: List[str]) -> Optional[int]:
        for k in keys:
            if k in it:
                v = num(it.get(k))
                if v is not None:
                    return v
        return None

    def pick_float(keys: List[str]) -> Optional[float]:
        for k in keys:
            if k in it:
                v = fnum(it.get(k))
                if v is not None:
                    return v
        return None

    delta = pick_int(delta_keys)
    prev_ = pick_int(prev_keys)
    after = pick_int(after_keys)

    if delta is None and prev_ is not None and after is not None:
        delta = after - prev_
    if prev_ is None and after is not None and delta is not None:
        prev_ = after - delta

    prev_r = pick_float(prev_r_keys)
    after_r = pick_float(after_r_keys)
    delta_r = pick_float(delta_r_keys)

    if delta_r is None and prev_r is not None and after_r is not None:
        delta_r = after_r - prev_r
    if prev_r is None and after_r is not None and delta_r is not None:
        prev_r = after_r - delta_r

    return (delta, prev_, after, delta_r, prev_r, after_r)


