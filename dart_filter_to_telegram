# ====== 신호강도 분류 (★★★/★★/★) ======
_PASSIVE_KEYWORDS: Optional[List[str]] = None


def _load_passive_keywords() -> List[str]:
    global _PASSIVE_KEYWORDS
    if _PASSIVE_KEYWORDS is None:
        path = Path(__file__).resolve().parent / "passive_funds.json"
        if path.exists():
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                raw = data.get("passive_keywords", []) or []
                _PASSIVE_KEYWORDS = [_normalize_actor(k) for k in raw if k]
            except (json.JSONDecodeError, OSError):
                _PASSIVE_KEYWORDS = []
        else:
            _PASSIVE_KEYWORDS = []
    return _PASSIVE_KEYWORDS


def _normalize_actor(s: str) -> str:
    if not s:
        return ""
    return (
        s.replace(" ", "")
        .replace("(주)", "")
        .replace("(株)", "")
        .replace("주식회사", "")
        .replace("(", "")
        .replace(")", "")
        .lower()
    )


def is_passive_actor(actor: str) -> bool:
    norm = _normalize_actor(actor)
    if not norm:
        return False
    for kw in _load_passive_keywords():
        if kw and kw in norm:
            return True
    return False


_TOP_EXECUTIVE_KW = ["대표이사", "회장", "부회장", "사장", "CEO", "CFO", "재무이사", "최고경영자"]


def classify_executive_rank(reason: str) -> str:
    """elestock reason 문자열에서 직위 추출. 'top'/'exec'/'shareholder'."""
    if not reason:
        return "shareholder"
    for kw in _TOP_EXECUTIVE_KW:
        if kw in reason:
            return "top"
    if any(k in reason for k in ["임원등록: 등록", "이사", "감사", "임원"]):
        return "exec"
    return "shareholder"


@lru_cache(maxsize=2048)
def get_close_price(stock_code: str, corp_cls: str, date_yyyymmdd: str) -> Optional[float]:
    """yfinance에서 보고일 종가 조회. 휴장일이면 이후 5거래일 내 첫 종가."""
    if not stock_code or len(stock_code) < 6:
        return None
    suffix = ".KS" if corp_cls == "Y" else (".KQ" if corp_cls == "K" else ".KS")
    ticker = f"{stock_code}{suffix}"
    try:
        import yfinance as yf
    except ImportError:
        return None

    d = dt.datetime.strptime(date_yyyymmdd, "%Y%m%d")
    start = d.strftime("%Y-%m-%d")
    end = (d + dt.timedelta(days=7)).strftime("%Y-%m-%d")

    # yfinance는 curl_cffi로 요청하므로 requests 예외 계열로는 타임아웃을 못 잡는다.
    # 종가 조회 실패가 전체 실행을 죽이지 않도록 모든 예외를 삼키고 재시도한다.
    for attempt in range(PRICE_FETCH_RETRIES):
        try:
            df = yf.Ticker(ticker).history(start=start, end=end)
            if df.empty:
                return None
            return float(df["Close"].iloc[0])
        except Exception as exc:
            if attempt == PRICE_FETCH_RETRIES - 1:
                print(f"[warn] 종가 조회 실패({ticker}): {type(exc).__name__}: {exc}")
                return None
            time.sleep(PRICE_FETCH_BACKOFF_SEC * (attempt + 1))
    return None


def classify_signal_strength(
    actor: str,
    reason: str,
    delta_sh: Optional[int],
    close_price: Optional[float],
) -> Tuple[str, Optional[int]]:
    """
    반환: (강도, 거래금액원화)
    - 패시브펀드 → ★
    - 대표이사·CEO·회장·사장 → ★★★
    - 거래금액 ₩1억+ → ★★★, ₩3천만~1억 → ★★
    - 그 외 → ★
    """
    if is_passive_actor(actor):
        return ("★", None)

    rank = classify_executive_rank(reason)
    amount: Optional[int] = None
    if delta_sh and close_price and delta_sh > 0:
        amount = int(delta_sh * close_price)

    if rank == "top":
        return ("★★★", amount)

    if amount is not None:
        if amount >= 100_000_000:
            return ("★★★", amount)
        if amount >= 30_000_000:
            return ("★★", amount)

    return ("★", amount)


def fmt_won(v: Optional[int]) -> str:
    if v is None:
        return ""
    if v >= 100_000_000:
        return f"≈ ₩{v / 100_000_000:.1f}억"
    if v >= 10_000_000:
        return f"≈ ₩{v / 10_000_000:.1f}천만"
    return f"≈ ₩{v:,}"

