KW_MAJOR = [
    "장내매수", "장내 매수", "장내매입", "장내 매입",
    "매수", "취득", "신주 취득", "유상증자 참여",
    "증여", "상속",
]
KW_MAJOR_EXCLUDE = ["장내매도", "장내 매도", "매도", "처분"]


def is_majorstock_target(item: Dict) -> bool:
    nm = str(item.get("report_nm", "")).replace(" ", "")
    return ("임원ㆍ주요주주특정증권등소유상황보고서" in nm) or ("임원주요주주특정증권등소유상황보고서" in nm)


def majorstock_pass(
    item: Dict,
) -> Tuple[
    bool, str, str, str,
    Optional[int], Optional[int], Optional[int],
    Optional[float], Optional[float], Optional[float],
]:
    corp_code = str(item.get("corp_code", ""))
    rcept_no = str(item.get("rcept_no", ""))

    # 임원ㆍ주요주주 특정증권 소유상황은 elestock.json이 원천 데이터
    elestock_item = dart_elestock_item(corp_code, rcept_no)
    if elestock_item:
        actor = dart_elestock_actor(elestock_item)
        delta_sh, prev_sh, after_sh, delta_pp, prev_r, after_r = dart_elestock_changes(elestock_item)
        reason = dart_elestock_reason(elestock_item)

        is_increase = (
            (delta_sh is not None and delta_sh > 0)
            or (delta_pp is not None and delta_pp > 0)
        )
        if not is_increase:
            return (False, "", "", "", None, None, None, None, None, None)

        if delta_sh is not None and delta_sh > 0:
            why = "보유주식수 증가"
        else:
            why = "보유비율 증가"

        return (True, why, reason, actor, delta_sh, prev_sh, after_sh, delta_pp, prev_r, after_r)

    # fallback: majorstock.json
    major_item = dart_majorstock_item(corp_code, rcept_no)
    if not major_item:
        return (False, "", "", "", None, None, None, None, None, None)

    reason = dart_majorstock_reason(corp_code, rcept_no, item=major_item)

    # 요청사항: 매도/처분/양도 성격은 알림에서 제외
    for ex in KW_MAJOR_EXCLUDE:
        if ex in reason:
            return (False, "", "", "", None, None, None, None, None, None)

    hit = ""
    for k in KW_MAJOR:
        if k in reason:
            hit = k
            break
    if hit == "":
        return (False, "", "", "", None, None, None, None, None, None)

    actor = dart_majorstock_actor(corp_code, rcept_no, item=major_item)  # 늘어난 주체(보고의무자) 후보
    delta_sh, prev_sh, after_sh, delta_pp, prev_r, after_r = dart_majorstock_changes(corp_code, rcept_no, item=major_item)
    return (True, hit, reason, actor, delta_sh, prev_sh, after_sh, delta_pp, prev_r, after_r)


KW_ASSET_TRANSFER = [
    "자산양수도", "자산 양수도",
    "자산양수", "자산 양수",
    "자산양도", "자산 양도",
    "영업양수도", "영업 양수도",
    "영업양수", "영업 양수",
    "영업양도", "영업 양도",
]


# 자산유동화(ABS) 노이즈 제외.
# "신한카드이천이십사의이유동화전문유한회사" 같은 SPC가 매일 '자산양도등의등록신청서'를
# 무더기로 올리는데, 이건 카드채권 유동화 절차일 뿐 투자 신호가 아니다.
# 상장사만 통과시키는 종목코드 조건이 사실상 SPC를 다 걸러내므로, 아래 키워드는
# 좁고 확실한 것만 둔다. "유한회사"·"등록신청서" 같은 넓은 말은 정상 공시를
# 잘못 거를 위험만 있고 실익이 없어 쓰지 않는다.
KW_ASSET_EXCLUDE_CORP = ["유동화전문", "유동화회사"]
KW_ASSET_EXCLUDE_REPORT = ["자산양도등의등록신청서", "자산유동화계획"]


def is_asset_transfer_report(item: Dict) -> Tuple[bool, str]:
    nm = str(item.get("report_nm", ""))

    # 상장사(종목코드 보유)만 대상. SPC·비상장사는 매매 대상이 아니라 신호 가치가 없다.
    if not str(item.get("stock_code", "")).strip():
        return False, ""

    corp = str(item.get("corp_name", ""))
    if any(kw in corp for kw in KW_ASSET_EXCLUDE_CORP):
        return False, ""
    if any(kw in nm for kw in KW_ASSET_EXCLUDE_REPORT):
        return False, ""

    for kw in KW_ASSET_TRANSFER:
        if kw in nm:
            return True, kw
    return False, ""


# ====== 메인 ======
def main(target_date: Optional[str] = None, dry_run: bool = False):
    if not DART_API_KEY:
        raise RuntimeError("DART_API_KEY가 필요합니다.")

    chat_id: Optional[str] = None
    if not dry_run:
        if not TG_TOKEN:
            raise RuntimeError("TELEGRAM_BOT_TOKEN가 필요합니다.")
        chat_id = TG_CHAT_ID
        if not chat_id:
            chat_id = tg_get_chat_id_auto()
            if not chat_id:
                raise RuntimeError(
                    "TELEGRAM_CHAT_ID를 못 찾았습니다.\n"
                    "1) 텔레그램에서 봇에게 DM으로 /start를 보낸 뒤\n"
                    "2) 스크립트를 다시 실행하거나\n"
                    "3) .env에 TELEGRAM_CHAT_ID를 직접 넣어주세요."
                )

    def _send(text: str) -> None:
        if dry_run:
            print("=" * 60)
            print(text)
        else:
            tg_send(text, chat_id)

    start_run_budget()

    today = target_date or kst_today_yyyymmdd()
    items = dart_list(today, today)
    total_count = len(items)

    major_hits: List[Dict] = []
    asset_hits: List[Dict] = []

    for it in items:
        corp = str(it.get("corp_name", "")).strip()
        stock = str(it.get("stock_code", "")).strip()
        report_nm = str(it.get("report_nm", "")).strip()
        rcept_no = str(it.get("rcept_no", "")).strip()
        rcept_dt = str(it.get("rcept_dt", "")).strip()
        link = dart_view_url(rcept_no)

        # (1) 대량보유
        if is_majorstock_target(it):
            ok, why, reason_text, actor, delta_sh, prev_sh, after_sh, delta_pp, prev_r, after_r = majorstock_pass(it)
            if ok:
                corp_cls = str(it.get("corp_cls", "")).strip()
                # 예산 초과 시 종가 조회를 건너뛴다. 금액 미상이면 ★ 기본 등급으로 분류된다.
                close = (
                    get_close_price(stock, corp_cls, rcept_dt)
                    if stock and not budget_exceeded()
                    else None
                )
                strength, amount = classify_signal_strength(actor, reason_text, delta_sh, close)
                major_hits.append({
                    "corp": corp, "stock": stock, "report": report_nm,
                    "why": why, "reason_text": reason_text, "actor": actor, "date": rcept_dt, "link": link,
                    "delta_sh": delta_sh, "prev_sh": prev_sh, "after_sh": after_sh,
                    "delta_pp": delta_pp, "prev_r": prev_r, "after_r": after_r,
                    "strength": strength, "amount": amount, "close_price": close,
                })
            continue

        # (2) 자산양수도 공시
        is_asset, kw = is_asset_transfer_report(it)
        if is_asset:
            asset_hits.append({
                "corp": corp, "stock": stock, "report": report_nm,
                "date": rcept_dt, "link": link, "why": kw
            })
            continue

    passed_count = len(major_hits) + len(asset_hits)

    # ===== 메시지 구성: 공시 1건당 1메시지 =====
    summary = (
        f"📌 DART 필터 리포트 (KST {today})\n"
        f"총 공시 {total_count}건 | 필터 통과 {passed_count}건\n"
        "발송 방식: 공시 1건당 1메시지"
    )
    if _dropped_count:
        summary += (
            f"\n⚠️ DART 조회 실패로 판정 못한 공시 {_dropped_count}건"
            " (누락 가능 — 로그 확인 필요)"
        )
    _send(summary)

    def build_major_message(x: Dict) -> str:
        corp = x["corp"]
        stock = x.get("stock", "")
        actor = (x.get("actor") or "").strip()
        ps = x.get("prev_sh")
        af = x.get("after_sh")
        ds = x.get("delta_sh")
        pr = x.get("prev_r")
        ar = x.get("after_r")
        dp = x.get("delta_pp")

        strength = x.get("strength", "★")
        amount = x.get("amount")
        lines = [f"{strength} ① 임원/주요주주 | {corp}" + (f" ({stock})" if stock else "")]
        lines.append(f"· 주체(보고의무자): {actor if actor else 'N/A'}")
        lines.append(f"· 사유분류: {x.get('why','')}")
        lines.append(f"· 상세사유: {x.get('reason_text','') or 'N/A'}")
        if amount:
            lines.append(f"· 거래금액: {fmt_won(amount)} (취득×보고일 종가)")
        if ps is not None and af is not None and ds is not None:
            sign = "+" if ds > 0 else ""
            lines.append(f"· 주식수 변동: {fmt_shares(ps)} → {fmt_shares(af)} ({sign}{fmt_shares(ds)})")
        elif ds is not None:
            sign = "+" if ds > 0 else ""
            lines.append(f"· 주식수 변동: {sign}{fmt_shares(ds)}")
        else:
            lines.append("· 주식수 변동: N/A")
        if pr is not None and ar is not None and dp is not None:
            lines.append(f"· 보유비율 변동: {fmt_ratio(pr)} → {fmt_ratio(ar)} ({fmt_pp(dp)})")
        elif pr is not None and ar is not None:
            lines.append(f"· 보유비율 변동: {fmt_ratio(pr)} → {fmt_ratio(ar)}")
        elif dp is not None:
            lines.append(f"· 보유비율 변동: {fmt_pp(dp)}")
        else:
            lines.append("· 보유비율 변동: N/A")
        lines.append(f"· 공시: {x.get('report','')}")
        lines.append(f"· 링크: {x.get('link','')}")
        return "\n".join(lines)

    def build_asset_message(x: Dict) -> str:
        corp = x["corp"]
        stock = x.get("stock", "")
        lines = [f"② 자산양수도 | {corp}" + (f" ({stock})" if stock else "")]
        lines.append(f"· 공시: {x.get('report','')}")
        lines.append(f"· 분류키워드: {x.get('why','')}")
        lines.append(f"· 링크: {x.get('link','')}")
        return "\n".join(lines)

    sent = 0
    for x in major_hits:
        _send(build_major_message(x))
        sent += 1
    for x in asset_hits:
        _send(build_asset_message(x))
        sent += 1

    if sent == 0:
        _send(f"KST {today} 기준 필터 통과 공시가 없습니다.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="DART 공시 필터 텔레그램 발송")
    parser.add_argument("--date", help="조회 기준일(KST) YYYYMMDD")
    parser.add_argument(
        "--days-ago",
        type=int,
        default=0,
        help="오늘(KST) 기준 며칠 전을 조회할지 지정 (기본값: 0)",
